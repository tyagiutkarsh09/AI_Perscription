# Copy to .env and fill in. .env must be git-ignored (never commit real keys).
# See key_essentials.md for where to get each.

# --- Required for a working POC ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
DATABASE_URL=mysql+pymysql://rxtool:replace-me@localhost:3306/rxtool
STT_BACKEND=fake                    # fake | deepgram
LLM_BACKEND=fake                    # fake | openai

# --- Local MySQL (replace password placeholders before docker compose) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rxtool
MYSQL_USER=rxtool
MYSQL_PASSWORD=
MYSQL_PORT=3306

# --- Drug data ---
BRAND_CATALOG_SOURCE=            # provider name or local file path (Indian brand catalog)
DRUGKNOWLEDGE_BACKEND=curated       # curated (other adapters are not implemented)
OPENFDA_API_KEY=                 # optional, raises free rate limit

# --- Licensed-later (leave blank until a vendor is chosen) ---
DRUGBANK_API_KEY=

# --- App ---
APP_ENV=dev                      # dev | pilot
